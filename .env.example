# Illustrative settings. The server does not automatically load .env files.
# Set environment variables in your shell, or use Start-App.ps1.
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
# OPERATOR_PASSWORD: set a private password (12+ characters) on first startup.
# WORKER_TOKEN: set a separate random private token for the Publisher runner.
# For an explicitly configured HTTPS proxy deployment only:
# APP_ORIGIN=https://your-approved-domain.example
# SECURE_COOKIES=true
